# Copie para .env na mesma pasta do executável e ajuste para o seu projeto.
# O .env não deve ser commitado: ele contém o token do Jira.

JIRA_BASE_URL=https://empresa.atlassian.net
JIRA_EMAIL=seu-email@empresa.com
JIRA_API_TOKEN=seu-token
# Data de validade do token (aparece em id.atlassian.com ao criar). O app avisa duas semanas antes.
# JIRA_API_TOKEN_EXPIRES=2026-12-31

# Use uma das três formas para escolher as issues:
JIRA_PROJECT_KEY=PROJ
# JIRA_PROJECT_KEYS=PROJ,ABC,XYZ
# JIRA_JQL=project = PROJ AND assignee = currentUser()

# Quadros do mesmo Jira para separar na tela (o seletor no topo): o número no fim do endereço do quadro,
# ex.: .../projects/RP/boards/215. Sem isso, o seletor separa pelo projeto da chave da task (PROJ-12).
# JIRA_BOARDS=215,514

POLLING_INTERVAL_SECONDS=5
# Sem interação por este tempo: POSSIVELMENTE IDLE (o tempo continua contando).
POSSIBLY_IDLE_SECONDS=120
# Sem interação por este tempo: INATIVO (o tempo pausa).
IDLE_THRESHOLD_SECONDS=300

# Onde gravar o histórico (SQLite). Padrão: chronos.db na pasta onde o app é aberto.
# CHRONOS_DB_PATH=chronos.db

# Colunas do quadro em que o tempo conta, além das padrão (Em andamento, Em progresso, In Progress).
# Escreva como aparece no quadro, separadas por vírgula. Ao sair delas, a task pausa.
# JIRA_IN_PROGRESS_STATUSES=Test
# Com false, só as colunas digitadas acima contam (sem as padrão).
# JIRA_USE_DEFAULT_STATUSES=true
# Com false, o tempo não começa sozinho quando a task entra numa dessas colunas: só pelo play.
# CHRONOS_AUTO_START=true
# Com true, a lista traz também as tasks dessas colunas de outros responsáveis ou sem responsável (ex.: tudo na
# coluna Test, para quem testa). Elas só contam tempo pelo play.
# JIRA_WATCH_WHOLE_COLUMNS=false
# Com true, tasks do Jira fora dessas colunas não aceitam tempo (nem play nem tempo manual).
# CHRONOS_ONLY_WORKING_COLUMNS=false

# Tags da validação (labels do Jira, separadas por vírgula). Ao começar o tempo de uma task, ela recebe as do play;
# quando sai das colunas monitoradas ou é finalizada, perde as do play e recebe as de terminar.
# CHRONOS_PLAY_LABELS=em-teste
# CHRONOS_DONE_LABELS=testado

# Com true, o Chronos abre no modo escuro (também dá para trocar em Configurações > Sistema).
# CHRONOS_DARK_MODE=false
# Idioma da interface: pt (padrão), en ou es. Vale ao reabrir o Chronos.
# CHRONOS_LANGUAGE=pt

# Tipos de task que geram aviso quando chegam nos projetos, de qualquer responsável (separados por vírgula).
# O Chronos mostra uma notificação do Windows e deixa uma bolinha vermelha no ícone até a janela ser aberta.
# CHRONOS_ALERT_ISSUE_TYPES=Bug Cliente
